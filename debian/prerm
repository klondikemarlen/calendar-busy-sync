#!/usr/bin/python3 -I
"""Remove only system-Python managed schedules before Debian package removal."""

from __future__ import annotations

import re
import shlex
import subprocess
import sys

BEGIN = "# BEGIN calendar-busy-sync managed schedule v1"
END = "# END calendar-busy-sync managed schedule v1"
CRONTAB = "/usr/bin/crontab"
ENVIRONMENT = {"PATH": "/usr/bin:/bin", "LC_ALL": "C"}


class CleanupError(Exception):
    """An uninstall failure that does not expose crontab contents."""


def without_system_schedule(text: str) -> str:
    """Select a well-formed Debian-owned block without evaluating its command."""
    lines = text.splitlines(keepends=True)
    markers = [
        index
        for index, line in enumerate(lines)
        if line.strip().startswith(("# BEGIN calendar-busy-sync", "# END calendar-busy-sync"))
    ]
    if not markers:
        return text
    if (
        len(markers) != 2
        or markers[1] != markers[0] + 2
        or lines[markers[0]].rstrip("\r\n") != BEGIN
        or lines[markers[1]].rstrip("\r\n") != END
    ):
        raise CleanupError("Managed schedule markers are malformed; review the crontab manually.")

    entry = lines[markers[0] + 1].rstrip("\r\n")
    fields = entry.split(None, 5)
    if (
        len(fields) != 6
        or not re.fullmatch(r"\*/(?:[1-9]|[1-5][0-9])", fields[0])
        or fields[1:5] != ["*"] * 4
    ):
        raise CleanupError("Managed schedule entry is malformed; review the crontab manually.")
    try:
        # Cron escapes percent signs even within shell quotes; undo only that escaping.
        command = shlex.split(fields[5].replace(r"\%", "%"))
    except ValueError:
        raise CleanupError("Managed schedule command is malformed; review the crontab manually.") from None
    while command and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", command[0]):
        name, _ = command.pop(0).split("=", 1)
        if name not in {"XDG_CONFIG_HOME", "XDG_STATE_HOME", "PATH"}:
            raise CleanupError("Managed schedule environment is unrecognized; review the crontab manually.")
    if (
        len(command) != 4
        or not command[0].startswith("/")
        or command[1:] != ["-m", "calendar_busy_sync", "sync"]
    ):
        raise CleanupError("Managed schedule command is unrecognized; review the crontab manually.")
    if command[0] != "/usr/bin/python3":
        return text
    return "".join(lines[: markers[0]] + lines[markers[1] + 1 :])


def local_accounts() -> list[str]:
    """Read only the local account database, not NSS or user-owned paths."""
    try:
        with open("/etc/passwd", encoding="utf-8") as source:
            rows = source.read().splitlines()
    except (OSError, UnicodeError):
        raise CleanupError("Could not enumerate local accounts; no cleanup was attempted.") from None
    accounts = []
    for row in rows:
        if not row or row.startswith("#"):
            continue
        fields = row.split(":")
        if (
            len(fields) != 7
            or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*\$?", fields[0])
            or not fields[2].isdigit()
        ):
            raise CleanupError("Local account database is unrecognized; no cleanup was attempted.")
        if fields[0] not in accounts:
            accounts.append(fields[0])
    return accounts


def invoke(account: str, *arguments: str, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            [CRONTAB, "-u", account, *arguments],
            input=input_text,
            text=True,
            capture_output=True,
            check=False,
            env=ENVIRONMENT,
            timeout=15,
        )
    except (OSError, UnicodeError, subprocess.TimeoutExpired):
        raise CleanupError(
            "Crontab command did not complete; review schedules before retrying removal."
        ) from None


def read_crontab(account: str) -> tuple[str, bool]:
    result = invoke(account, "-l")
    if result.returncode == 0:
        return result.stdout, True
    if result.returncode == 1 and result.stderr.strip() == f"no crontab for {account}":
        return "", False
    raise CleanupError("Could not read crontab; no changes were made for this account.")


def remove_schedules() -> None:
    # Preflight every account before changing any, then compare again per mutation.
    pending = []
    for account in local_accounts():
        try:
            before = read_crontab(account)
            clean = without_system_schedule(before[0])
        except CleanupError as error:
            raise CleanupError(f"Account {account!r}: {error}") from None
        if clean != before[0]:
            pending.append((account, before, clean))
    for account, before, clean in pending:
        try:
            if read_crontab(account) != before:
                raise CleanupError("Crontab changed during cleanup; no changes were made for this account.")
            if clean:
                result = invoke(account, "-", input_text=clean)
            else:
                result = invoke(account, "-r")
            if result.returncode:
                raise CleanupError("Could not remove managed schedule; review the crontab before retrying.")
        except CleanupError as error:
            raise CleanupError(f"Account {account!r}: {error}") from None


def main(arguments: list[str]) -> int:
    if not arguments or arguments[0] != "remove":
        return 0
    try:
        remove_schedules()
    except CleanupError as error:
        print(f"calendar-busy-sync prerm: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
